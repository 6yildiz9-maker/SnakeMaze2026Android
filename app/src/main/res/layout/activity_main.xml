<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/mainRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/nokia_bg"
    tools:context=".MainActivity">

    <TextView
        android:id="@+id/scoreTextView"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:fontFamily="serif-monospace"
        android:textSize="24sp"
        android:textColor="@color/nokia_dark_text"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toEndOf="@+id/btnBack"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="16dp"
        android:visibility="gone"
        android:textStyle="bold"/>

    <com.example.snakemaze2026.SnakeView
        android:id="@+id/snakeView"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintTop_toBottomOf="@+id/scoreTextView"
        app:layout_constraintBottom_toTopOf="@+id/controlsContainer"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:visibility="gone"/>

    <ScrollView
        android:id="@+id/menuScrollView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true"
        android:scrollbars="none">

        <LinearLayout
            android:id="@+id/menuLayout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="30dp">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnLanguage"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="EN"
            app:icon="@android:drawable/ic_menu_sort_alphabetically"
            style="@style/Widget.MaterialComponents.Button.TextButton"
            android:textColor="@color/nokia_dark_text"
            app:iconTint="@color/nokia_dark_text"
            android:layout_gravity="end"
            android:layout_marginBottom="10dp"
            android:textStyle="bold"/>

        <TextView
            android:id="@+id/titleText"
            android:layout_width="match_parent"
            android:layout_height="120dp"
            app:autoSizeTextType="uniform"
            app:autoSizeMinTextSize="24sp"
            app:autoSizeMaxTextSize="72sp"
            android:gravity="center"
            android:text="@string/title_name"
            android:textColor="@color/nokia_dark_text"
            android:textStyle="bold"
            android:fontFamily="serif-monospace"
            android:letterSpacing="0.05"
            android:layout_marginTop="80dp"
            android:layout_marginBottom="40dp"
            android:padding="8dp"/>

        <TextView
            android:id="@+id/highScoreTextView"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="serif-monospace"
            android:textSize="22sp"
            android:textColor="@color/nokia_dark_text"
            android:layout_marginBottom="24dp"
            android:textStyle="bold"/>

        <TextView
            android:id="@+id/finalScoreText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="serif-monospace"
            android:textSize="20sp"
            android:textColor="@color/nokia_dark_text"
            android:textStyle="bold"
            android:visibility="gone"/>

        <TextView
            android:id="@+id/rankTextView"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="serif-monospace"
            android:textSize="18sp"
            android:textColor="@color/nokia_dark_text"
            android:visibility="gone"
            android:layout_marginBottom="20dp"/>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnStart"
            android:layout_width="280dp"
            android:layout_height="65dp"
            android:text="@string/new_game"
            app:cornerRadius="8dp"
            android:textSize="18sp"
            android:layout_marginBottom="12dp"
            app:strokeColor="@color/nokia_dark_text"
            app:strokeWidth="3dp"
            android:backgroundTint="@android:color/transparent"
            android:textColor="@color/nokia_dark_text"
            android:textStyle="bold"/>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnResume"
            android:layout_width="280dp"
            android:layout_height="65dp"
            android:text="@string/resume_game"
            app:cornerRadius="8dp"
            android:textSize="18sp"
            android:layout_marginBottom="12dp"
            android:visibility="gone"
            app:strokeColor="@color/nokia_dark_text"
            app:strokeWidth="3dp"
            android:backgroundTint="@android:color/transparent"
            android:textColor="@color/nokia_dark_text"
            android:textStyle="bold"/>


        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnHome"
            android:layout_width="280dp"
            android:layout_height="65dp"
            android:text="@string/main_menu"
            app:cornerRadius="8dp"
            android:textSize="18sp"
            android:layout_marginBottom="12dp"
            android:visibility="gone"
            app:strokeColor="#FF1111"
            app:strokeWidth="3dp"
            android:backgroundTint="@android:color/transparent"
            android:textColor="#FF1111"
            android:textStyle="bold"/>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnCareer"
            android:layout_width="280dp"
            android:layout_height="65dp"
            android:text="@string/career"
            app:cornerRadius="8dp"
            android:textSize="18sp"
            android:layout_marginBottom="12dp"
            app:strokeColor="@color/nokia_dark_text"
            app:strokeWidth="3dp"
            android:backgroundTint="@android:color/transparent"
            android:textColor="@color/nokia_dark_text"
            android:textStyle="bold"/>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnSettings"
            android:layout_width="280dp"
            android:layout_height="65dp"
            android:text="@string/settings"
            app:cornerRadius="8dp"
            android:textSize="18sp"
            android:layout_marginBottom="40dp"
            app:strokeColor="@color/nokia_dark_text"
            app:strokeWidth="3dp"
            android:backgroundTint="@android:color/transparent"
            android:textColor="@color/nokia_dark_text"
            android:textStyle="bold"/>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnShareScore"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/share_score"
            app:cornerRadius="16dp"
            android:visibility="gone"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/support_developer"
            android:textColor="#AAAAAA"
            android:textSize="12sp"
            android:layout_marginBottom="5dp"/>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnAds"
            android:layout_width="280dp"
            android:layout_height="55dp"
            android:text="@string/watch_ads"
            app:cornerRadius="8dp"
            android:textSize="14sp"
            app:icon="@android:drawable/ic_menu_slideshow"
            android:layout_marginBottom="10dp"
            app:strokeColor="@color/nokia_dark_text"
            app:strokeWidth="1.5dp"
            android:backgroundTint="@android:color/transparent"
            android:textColor="@color/nokia_dark_text"
            app:iconTint="@color/nokia_dark_text"
            android:textStyle="bold"/>


        </LinearLayout>
    </ScrollView>

    <FrameLayout
        android:id="@+id/controlsContainer"
        android:layout_width="0dp"
        android:layout_height="280dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:visibility="gone">

        <RelativeLayout
            android:id="@+id/gameControls"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:padding="16dp"
            android:visibility="gone">

            <ImageButton
                android:id="@+id/btnLeft"
                android:layout_width="150dp"
                android:layout_height="150dp"
                android:src="@drawable/ic_arrow_left_down"
                android:background="@drawable/round_button_background"
                android:layout_alignParentStart="true"
                android:layout_centerVertical="true"
                android:contentDescription="@string/turn_left" />

            <ImageButton
                android:id="@+id/btnRight"
                android:layout_width="150dp"
                android:layout_height="150dp"
                android:src="@drawable/ic_arrow_right_up"
                android:background="@drawable/round_button_background"
                android:layout_alignParentEnd="true"
                android:layout_centerVertical="true"
                android:contentDescription="@string/turn_right" />
        </RelativeLayout>

        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/gameControls2"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:padding="16dp"
            android:visibility="gone">


            <ImageButton
                android:id="@+id/btnAltUp"
                android:layout_width="100dp"
                android:layout_height="100dp"
                android:src="@drawable/ic_arrow_up"
                android:background="@drawable/round_button_background"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                android:contentDescription="@string/turn_up" />

            <ImageButton
                android:id="@+id/btnAltDown"
                android:layout_width="100dp"
                android:layout_height="100dp"
                android:src="@drawable/ic_arrow_down"
                android:background="@drawable/round_button_background"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                android:contentDescription="@string/turn_down" />

            <ImageButton
                android:id="@+id/btnAltLeft"
                android:layout_width="100dp"
                android:layout_height="100dp"
                android:src="@drawable/ic_arrow_left"
                android:background="@drawable/round_button_background"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                android:contentDescription="@string/turn_left" />

            <ImageButton
                android:id="@+id/btnAltRight"
                android:layout_width="100dp"
                android:layout_height="100dp"
                android:src="@drawable/ic_arrow_right"
                android:background="@drawable/round_button_background"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                android:contentDescription="@string/turn_right" />

        </androidx.constraintlayout.widget.ConstraintLayout>
        <View
            android:id="@+id/btnSwipeSensor"
            android:layout_width="200dp"
            android:layout_height="200dp"
            android:layout_gravity="center"
            android:background="@drawable/swipe_button_background"
            android:visibility="gone" />

    </FrameLayout>


    <ImageButton
        android:id="@+id/btnBack"
        android:layout_width="50dp"
        android:layout_height="50dp"
        android:elevation="20dp"
        android:background="@android:color/transparent"
        android:src="@drawable/ic_arrow_back"
        app:tint="#FF0000"
        android:scaleType="centerInside"
        android:visibility="gone"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        android:layout_marginStart="16dp"
        android:layout_marginTop="16dp"
        android:contentDescription="Back" />

    <TextView
        android:id="@+id/countdownTextView"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textSize="100sp"
        android:textColor="#FFFFFF"
        android:textStyle="bold"
        android:elevation="30dp"
        android:visibility="gone"
        android:shadowColor="#000000"
        android:shadowDx="5"
        android:shadowDy="5"
        android:shadowRadius="10"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
