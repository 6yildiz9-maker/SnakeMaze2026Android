<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="24dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Red"
        android:labelFor="@+id/sliderRed"/>
    <com.google.android.material.slider.Slider
        android:id="@+id/sliderRed"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:valueFrom="0"
        android:valueTo="255"
        app:thumbColor="@color/md_red_500"
        app:trackColorActive="@color/md_red_300"
        android:stepSize="1" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Green"
        android:labelFor="@+id/sliderGreen"/>
    <com.google.android.material.slider.Slider
        android:id="@+id/sliderGreen"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:valueFrom="0"
        android:valueTo="255"
        app:thumbColor="@color/md_green_500"
        app:trackColorActive="@color/md_green_300"
        android:stepSize="1" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Blue"
        android:labelFor="@+id/sliderBlue"/>
    <com.google.android.material.slider.Slider
        android:id="@+id/sliderBlue"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:valueFrom="0"
        android:valueTo="255"
        app:thumbColor="@color/md_blue_500"
        app:trackColorActive="@color/md_blue_300"
        android:stepSize="1" />

    <androidx.cardview.widget.CardView
        android:layout_width="100dp"
        android:layout_height="100dp"
        android:layout_gravity="center"
        app:cardCornerRadius="12dp"
        app:cardElevation="4dp"
        android:layout_marginTop="16dp">
        <View
            android:id="@+id/colorPreview"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />
    </androidx.cardview.widget.CardView>

</LinearLayout>